{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "最终交付证据账本（只追加）",
  "type": "object",
  "required": [
    "version",
    "contracts",
    "artifacts",
    "approvals"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "slots",
          "decisions"
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "slot",
          "path",
          "snapshot",
          "contractDigest",
          "provenance",
          "technical",
          "aspect",
          "format"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "slot": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "dependencies": {
            "type": "object",
            "required": [
              "groups",
              "unknown",
              "fontFiles",
              "boundary"
            ],
            "properties": {
              "groups": {
                "type": "object"
              },
              "unknown": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "fontFiles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "boundary": {
                "type": "string"
              }
            }
          },
          "snapshot": {
            "type": "object",
            "required": [
              "kind",
              "entries",
              "sha256"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "file",
                  "directory"
                ]
              },
              "entries": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "size",
                    "sha256"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "contractDigest": {
            "type": "string"
          },
          "technical": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "accepted-with-warnings",
                  "hard-error",
                  "unknown"
                ]
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "generatedAt": {
            "type": "string"
          },
          "observedAt": {
            "type": "string"
          },
          "aspect": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "tool": {
            "type": "object",
            "required": [
              "node",
              "platform",
              "arch"
            ],
            "properties": {
              "node": {
                "type": "string"
              },
              "platform": {
                "type": "string"
              },
              "arch": {
                "type": "string"
              },
              "executables": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "path",
                    "sha256"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    }
                  }
                }
              },
              "packages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "version",
                    "source"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "step",
          "revision",
          "bindings",
          "source",
          "at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "step": {
            "type": "integer",
            "enum": [
              13,
              14,
              15
            ]
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bindings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "slot",
                "path",
                "snapshot"
              ],
              "properties": {
                "slot": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "snapshot": {
                  "type": "object",
                  "required": [
                    "kind",
                    "entries",
                    "sha256"
                  ],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "file",
                        "directory"
                      ]
                    },
                    "entries": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "path",
                          "size",
                          "sha256"
                        ],
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "size": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          }
                        }
                      }
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              }
            }
          },
          "source": {
            "type": "string",
            "pattern": ".+"
          },
          "at": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "direct",
              "source"
            ]
          }
        }
      }
    }
  }
}
