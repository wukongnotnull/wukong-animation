{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wukong-animation/film.schema.json",
  "title": "wukong-animation film.json（一支片的机器可读描述，与 storyboard.md 对应）",
  "type": "object",
  "required": [
    "title",
    "style",
    "size",
    "fps",
    "seed",
    "shots"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "style": {
      "type": "string"
    },
    "size": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 16
      },
      "minItems": 2
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "seed": {
      "type": "integer"
    },
    "scripts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "file",
          "duration"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s\\d{2,3}$"
          },
          "file": {
            "type": "string"
          },
          "duration": {
            "type": "number",
            "minimum": 0.1
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "build": {
          "type": "string"
        },
        "voiceover": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "at"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "at": {
                "type": "number",
                "minimum": 0
              },
              "voice": {
                "type": "string"
              },
              "cue": {
                "type": "string",
                "pattern": "^[\\w\\u4e00-\\u9fa5-]+$"
              },
              "file": {
                "type": "string",
                "description": "用户自供的 VO 录音（相对片目录），vo_source 为 user 时必填"
              }
            }
          }
        },
        "tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "file"
            ],
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string"
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "gain": {
                "type": "number"
              }
            }
          }
        },
        "vo_source": {
          "type": "string",
          "enum": [
            "user",
            "ai",
            "none"
          ],
          "description": "VO 素材来源：user = 用户自供录音；ai = AI 配音（TTS）；none = 无 VO。第 6 道工序审片节点④由用户签批"
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "formats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        }
      }
    },
    "cues": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "number",
          "minimum": 0
        },
        "minItems": 2
      }
    }
  }
}
