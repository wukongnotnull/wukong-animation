{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wukong-animation/film.schema.json",
  "title": "wukong-animation film.json（一支片的机器可读描述，与 storyboard.md 对应）",
  "type": "object",
  "required": [
    "title",
    "style",
    "size",
    "fps",
    "seed",
    "shots"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "style": {
      "type": "string"
    },
    "size": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 16
      },
      "minItems": 2
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "seed": {
      "type": "integer"
    },
    "scripts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "file",
          "duration"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s\\d{2,3}$"
          },
          "file": {
            "type": "string"
          },
          "duration": {
            "type": "number",
            "minimum": 0.1
          },
          "note": {
            "type": "string"
          },
          "size": {
            "type": "string",
            "enum": ["大远景", "远景", "全景", "中景", "近景", "特写", "大特写"],
            "description": "景别（画面框多大），与 storyboard.md 的景别栏一致。第 5 道签批时 wka 检查：每镜都写、4 镜及以上至少 3 种、相邻两镜不同"
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "build": {
          "type": "string"
        },
        "voices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "at"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "vo",
                  "dialogue",
                  "os",
                  "live"
                ],
                "description": "人声类型：vo 画外音（默认，含旁白、内心独白）/ dialogue 出镜对白 / os 画外但在场景里 / live 同期声（现场原声、采访，必须挂接 file）"
              },
              "speaker": {
                "type": "string",
                "description": "说话的人或声音来源，对应分镜「人声」栏的括号，如 对白（老者）"
              },
              "at": {
                "type": "number",
                "minimum": 0
              },
              "voice": {
                "type": "string"
              },
              "rate": {
                "type": "string",
                "pattern": "^[+-]\\d{1,3}%$",
                "description": "AI 配音语速，如 -30%（更慢）、+10%（更快）。只对 edge-tts 生效，挂接录音的条目忽略"
              },
              "pitch": {
                "type": "string",
                "pattern": "^[+-]\\d{1,3}Hz$",
                "description": "AI 配音音高，如 -4Hz（更低）。只对 edge-tts 生效，挂接录音的条目忽略"
              },
              "chars": {
                "type": "boolean",
                "description": "true 时 wka soundtrack 给这一句的每个字写同步点 <cue>#1、<cue>#2……，镜头里用 s.cueChars('<cue>') 读（题字逐字跟着人声）"
              },
              "cue": {
                "type": "string",
                "pattern": "^[\\w\\u4e00-\\u9fa5-]+$"
              },
              "file": {
                "type": "string",
                "description": "人声录音（相对片目录）。voice_source 为 user 或 kind 为 live 时必填"
              }
            }
          }
        },
        "tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "file"
            ],
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string"
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "gain": {
                "type": "number"
              }
            }
          }
        },
        "voice_source": {
          "type": "string",
          "enum": [
            "user",
            "ai",
            "none"
          ],
          "description": "人声素材来源：user = 用户自供录音；ai = AI 配音（TTS）；none = 无人声。第 6 道工序审片节点④由用户签批。旧名 vo_source 仍可用"
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "formats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        }
      }
    },
    "cues": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "number",
          "minimum": 0
        },
        "minItems": 2
      }
    },
    "subtitles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "description": "字幕（第 11 道工序）：以片目录里的 srt 为准，由 wka subtitles 从人声生成。没有这个字段即不出字幕",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "srt",
            "burn",
            "both"
          ],
          "description": "none 不出字幕 / srt 只外挂 / burn 只烧录 / both 两者"
        },
        "file": {
          "type": "string",
          "description": "字幕文件，相对片目录，缺省 subtitles.srt"
        },
        "max_chars": {
          "type": "integer",
          "minimum": 4,
          "description": "每条字幕最多几个字（标点不计），缺省横屏 18、竖屏 12、方形 14"
        },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "description": "这支片的字幕样式，逐项覆盖风格 style.json 的 subtitles 块（font 整体替换，stroke 按字段合并）。改字幕样式写这里，不改插件目录里的 style.json",
          "properties": {
            "font": {
              "type": "object",
              "required": [
                "family"
              ],
              "additionalProperties": false,
              "properties": {
                "family": {
                  "type": "string"
                },
                "fallback": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "size": {
              "type": "number",
              "minimum": 0.01,
              "description": "字号，占画面高度的比例，缺省 0.045"
            },
            "color": {
              "type": "string",
              "description": "文字颜色，缺省 #FFFFFF"
            },
            "stroke": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "color": {
                  "type": "string"
                },
                "width": {
                  "type": "number",
                  "minimum": 0,
                  "description": "描边宽度，字号的倍数"
                }
              },
              "description": "描边，缺省 rgba(0,0,0,0.65)、0.08"
            },
            "bottom": {
              "type": "number",
              "minimum": 0,
              "description": "文字底边到画面底边的距离，占画面高度的比例，缺省 0.08"
            }
          }
        }
      }
    }
  }
}
