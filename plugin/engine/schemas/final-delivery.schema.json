{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "最终交付证据账本（只追加）",
  "type": "object",
  "required": ["version", "contracts", "artifacts", "approvals"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "enum": [1]},
    "contracts": {"type": "array", "items": {"type": "object", "required": ["id", "slots", "decisions"]}},
    "artifacts": {"type": "array", "items": {"type": "object", "required": ["id", "slot", "path", "snapshot", "contractDigest", "provenance", "technical"], "properties": {
      "id": {"type": "string"}, "slot": {"type": "string"}, "path": {"type": "string"},
      "snapshot": {"type": "object", "required": ["kind", "entries", "sha256"], "properties": {"kind": {"type": "string", "enum": ["file", "directory"]}, "entries": {"type": "array", "minItems": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
      "contractDigest": {"type": "string"}, "technical": {"type": "object", "required": ["status"], "properties": {"status": {"type": "string", "enum": ["passed", "accepted-with-warnings", "hard-error", "unknown"]}}}
    }}},
    "approvals": {"type": "array", "items": {"type": "object", "required": ["id", "step", "revision", "bindings", "source", "at"], "properties": {"id": {"type": "string"}, "step": {"type": "integer", "enum": [13,14,15]}, "revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bindings": {"type": "array"}, "source": {"type": "string"}, "at": {"type": "string"}}}}
  }
}
