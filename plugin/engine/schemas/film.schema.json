{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wukong-animation/film.schema.json",
  "title": "wukong-animation film.json（一支片的机器可读描述，与 storyboard.md 对应）",
  "type": "object",
  "required": [
    "title",
    "style",
    "size",
    "fps",
    "seed",
    "shots"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "style": {
      "type": "string"
    },
    "size": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 16
      },
      "minItems": 2
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "seed": {
      "type": "integer"
    },
    "scripts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shots": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "id",
          "file",
          "duration"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s\\d{2,3}$"
          },
          "file": {
            "type": "string"
          },
          "duration": {
            "type": "number",
            "minimum": 0.1
          },
          "note": {
            "type": "string"
          },
          "size": {
            "type": "string",
            "enum": [
              "大远景",
              "远景",
              "全景",
              "中景",
              "近景",
              "特写",
              "大特写"
            ],
            "description": "景别（画面框多大），与 storyboard.md 的景别栏一致。第 5 道签批时 wka 检查：每镜都写、4 镜及以上至少 3 种、相邻两镜不同"
          },
          "full_bleed": {
            "type": "boolean",
            "description": "这一镜画面铺满一张图（截图、照片），wka qc 不查这一镜的留白"
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "build": {
          "type": "string"
        },
        "voices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "at"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "vo",
                  "dialogue",
                  "os",
                  "live"
                ],
                "description": "人声类型：vo 画外音（默认，含旁白、内心独白）/ dialogue 出镜对白 / os 画外但在场景里 / live 同期声（现场原声、采访，必须挂接 file）"
              },
              "speaker": {
                "type": "string",
                "description": "说话的人或声音来源，对应分镜「人声」栏的括号，如 对白（老者）"
              },
              "at": {
                "type": "number",
                "minimum": 0
              },
              "chars": {
                "type": "boolean",
                "description": "true 时 wka soundtrack 给这一句的每个字写同步点 <cue>#1、<cue>#2……，镜头里用 s.cueChars('<cue>') 读（题字逐字跟着人声）"
              },
              "cue": {
                "type": "string",
                "pattern": "^[\\w\\u4e00-\\u9fa5-]+$"
              },
              "file": {
                "type": "string",
                "description": "用户录音（相对片目录）；每段完整录音只登记一次。"
              }
            }
          }
        },
        "tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "file"
            ],
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string"
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "gain": {
                "type": "number"
              }
            }
          }
        },
        "voice_source": {
          "type": "string",
          "enum": [
            "user",
            "none"
          ],
          "description": "人声来源：user 用户录音；none 无人声。整段或多段录音均可，按实际声音编排。"
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "formats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        }
      }
    },
    "cues": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "number",
          "minimum": 0
        },
        "minItems": 2
      }
    },
    "subtitles": {
      "type": "object",
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "none"
        }
      },
      "description": "仅识别已明确关闭的配置；新项目不使用字幕。"
    },
    "variants": {
      "type": "object",
      "description": "副版画幅（主版是 size）：键是画幅（如 \"9:16\"），值是这一版的覆盖项；没有这个字段即只出主版",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "export": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "副版成片名，缺省为主版名加 -<画幅后缀>"
              }
            }
          }
        }
      }
    }
  }
}
